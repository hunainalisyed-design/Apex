# Base URL of the backend Express API.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Set to "false" to hide the CarAI floating button and nav control entirely (Spec 15) —
# mirrors the backend's own AI_ASSISTANT_ENABLED flag (Spec 14); keep both in sync manually.
# Any other value, or unset, leaves the assistant visible.
NEXT_PUBLIC_AI_ASSISTANT_ENABLED="true"
