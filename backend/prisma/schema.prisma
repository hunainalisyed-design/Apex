// Prisma schema.
// Spec 01: datasource/generator only. Spec 02: vehicle catalog data model.
// Spec 06: ApplyMode (owned by Spec 8's definition, migrated here per its Risk #3) + customPaintHex.
// Spec 10: Configuration.expiresAt (guest-build retention, see that spec's §4).
// Spec 12: Vehicle.fallbackImageUrl (WebGL-unavailable static fallback, see that spec's §4).
// Spec 16: User/Session/PasswordResetToken + Configuration.userId's real FK (see that spec's §4).
// Spec 19: Lead (see that spec's §4).
// Spec 20: Reservation (see that spec's §4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OptionCategory {
  PAINT
  WHEELS
  BRAKE_CALIPER
  WINDOW_TINT
  SPOILER
  FRONT_ACCESSORY
  REAR_ACCESSORY
  BODY_PACKAGE
  CARBON_COMPONENT
  INTERIOR_MATERIAL
  INTERIOR_LIGHTING
  INTERIOR_SEATS
  INTERIOR_DASHBOARD
  INTERIOR_STEERING_WHEEL
  INTERIOR_DOOR_PANELS
  INTERIOR_FLOOR
  ACCESSORY
  PACKAGE
}

/// How a selected option's assetRef should be applied to the 3D scene (Spec 6/8).
enum ApplyMode {
  MATERIAL_SWAP // the mesh is always visible; only its material/color changes
  MESH_VARIANT_SWAP // multiple distinct mesh variants exist; the selected one is shown
  MESH_VISIBILITY // toggles a specific mesh's visibility (optionally tinting it too)
}

/// Real enums rather than the spec's own plain-string sketch (Spec 19 §4) — matches this
/// schema's established convention (OptionCategory, ApplyMode) for every other fixed-value
/// field; Spec 21's admin panel only ever needs to toggle LeadStatus between these three
/// known values, never write an arbitrary future one.
enum PreferredContact {
  EMAIL
  PHONE
}

enum LeadRequestType {
  QUOTE
  TEST_DRIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ReservationStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Vehicle {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  tagline          String
  basePriceCents   Int
  currency         String   @default("EUR")
  horsepower       Int
  topSpeedKph      Int
  zeroToHundredSec Decimal  @db.Decimal(3, 1)
  heroModelUrl     String
  showroomModelUrl String
  thumbnailUrl     String
  fallbackImageUrl String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  options        CustomizationOption[]
  configurations Configuration[]
}

model CustomizationOption {
  id              String         @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category        OptionCategory
  name            String
  description     String?
  priceDeltaCents Int            @default(0)
  assetRef        String
  swatchColor     String?
  applyMode       ApplyMode      @default(MATERIAL_SWAP)
  isDefault       Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  selections ConfigurationSelection[]

  @@index([vehicleId, category])
}

model Configuration {
  id              String   @id @default(cuid())
  publicId        String   @unique // e.g. "APEX-7F82-K91X", generated in the save/share spec
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  userId          String? // null = guest build
  // SetNull (not the Prisma default Restrict): a future account deletion (Phase 3 GDPR
  // erasure) must not fail just because the account owns a configuration — the shared
  // publicId link should keep resolving, reverting to a guest-owned-looking row, rather
  // than blocking the deletion (Spec 16 §4 gap, resolved here).
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  totalPriceCents Int
  customPaintHex  String? // set only when the selected PAINT option is the reserved custom-color entry
  expiresAt       DateTime? // null = never expires (reserved for future account-owned builds); guest builds get now+90d, refreshed on every load
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selections   ConfigurationSelection[]
  leads        Lead[]
  reservations Reservation[]

  @@index([userId])
}

model ConfigurationSelection {
  id              String              @id @default(cuid())
  configurationId String
  configuration   Configuration       @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  optionId        String
  option          CustomizationOption @relation(fields: [optionId], references: [id])

  @@unique([configurationId, optionId])
}

/// The first spec to store real personal data (Spec 16 §4's own Retention & privacy note).
model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  termsAcceptedAt DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  configurations      Configuration[]
  leads               Lead[]
  reservations        Reservation[]
}

/// An opaque, cryptographically random session token's hash — never the raw token itself,
/// so a database read alone can never be used to impersonate a session (Spec 16 §3).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Single-use, 1-hour-lived password reset tokens (Spec 16 AC-7/AC-8) — same hash-only
/// storage rationale as Session.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A quote/test-drive request tied to the exact Configuration the requester was looking at
/// (Spec 19). `configuration` is deliberately left Restrict (Prisma's default, no onDelete
/// annotation) rather than Cascade or SetNull — a Lead is meant to be a durable business
/// record for Spec 21's admin panel, so it should never silently disappear or lose its
/// business context just because the underlying build was later deleted. `user` gets
/// SetNull, mirroring Configuration.userId's own precedent, since a future account deletion
/// shouldn't be blocked by, or destroy, a lead record.
model Lead {
  id               String           @id @default(cuid())
  configurationId  String
  configuration    Configuration    @relation(fields: [configurationId], references: [id])
  userId           String? // null = guest submission (Spec 19 AC-4)
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  preferredContact PreferredContact
  message          String?
  requestType      LeadRequestType
  status           LeadStatus       @default(NEW) // managed by Spec 21's admin panel
  createdAt        DateTime         @default(now())

  @@index([status])
  @@index([configurationId])
  @@index([userId])
}

/// A Stripe test-mode deposit reservation tied to the exact Configuration the user was
/// checking out (Spec 20). `configuration` is deliberately left Restrict (Prisma's
/// default, no onDelete annotation) — same reasoning as Lead above, written explicitly
/// this time rather than left implicit: a Reservation is a durable business/payment record
/// for Spec 21's admin panel and should never silently disappear just because the
/// underlying build was later deleted. `user` gets SetNull, mirroring Lead.userId, so a
/// future account deletion isn't blocked by, or doesn't destroy, a reservation record.
/// `stripeCheckoutSessionId` is nullable because it isn't known until after Stripe returns
/// the created session, which itself needs this row's `id` already assigned (for its
/// success_url) — the row is created first with this field null, then updated once Stripe
/// responds. Postgres unique constraints ignore multiple NULLs, so this is safe.
model Reservation {
  id                      String            @id @default(cuid())
  configurationId         String
  configuration           Configuration     @relation(fields: [configurationId], references: [id])
  userId                  String? // null = guest reservation
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeCheckoutSessionId String?           @unique
  amountCents             Int
  currency                String            @default("EUR")
  status                  ReservationStatus @default(PENDING)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([configurationId])
  @@index([userId])
  @@index([status])
}
