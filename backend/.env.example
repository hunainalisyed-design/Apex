# Postgres connection string. Matches the docker-compose.yml service by default.
DATABASE_URL="postgresql://apex:apex@localhost:5432/apex_dev?schema=public"

# Port the Express server listens on.
PORT=4000

# Allowed CORS origin for the frontend dev server.
FRONTEND_ORIGIN="http://localhost:3000"

# Claude API key (Spec 14) — backend-only, never referenced by any frontend code path.
ANTHROPIC_API_KEY=""

# Set to "false" to disable POST /api/ai/configure instantly without a deploy (Spec 14
# Rollout) — e.g. during a Claude API outage or a cost runaway. Any other value, or unset,
# leaves it enabled.
AI_ASSISTANT_ENABLED="true"

# Resend API key (Spec 16) — backend-only. Left unset here; POST /api/auth/forgot-password
# falls back to logging the reset link to the console instead of sending a real email.
RESEND_API_KEY=""

# The dealer inbox that receives lead-capture notifications (Spec 19, Risk #1 — a single
# configured address, not real multi-dealer routing). Falls back to a placeholder if unset.
DEALER_INBOX_EMAIL="dealer@apex.example"
